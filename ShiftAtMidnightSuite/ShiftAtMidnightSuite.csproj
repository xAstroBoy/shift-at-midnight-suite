<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShiftAtMidnightSuite.Plugin</AssemblyName>
    <RootNamespace>ShiftAtMidnightSuite</RootNamespace>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0168;CS0414</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>$(MSBuildThisFileDirectory)..\..\</GameDir>
    <MlDir>$(GameDir)MelonLoader\net6\</MlDir>
    <Il2CppDir>$(GameDir)MelonLoader\Il2CppAssemblies\</Il2CppDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ShiftAtMidnightSuite.Loader"><HintPath>$(MSBuildThisFileDirectory)..\ShiftAtMidnightSuite.Loader\bin\Release\ShiftAtMidnightSuite.Loader.dll</HintPath></Reference>
    <Reference Include="UniverseLib"><HintPath>$(GameDir)UserLibs\UniverseLib.ML.IL2CPP.Interop.dll</HintPath></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MlDir)MelonLoader.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(MlDir)0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MlDir)Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(MlDir)Il2CppInterop.Common.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Il2CppDir)Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppDir)Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(Il2CppDir)Il2CppSystem.dll</HintPath></Reference>
    <Reference Include="Il2CppSystem.Core"><HintPath>$(Il2CppDir)Il2CppSystem.Core.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Il2CppDir)UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppDir)UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppDir)UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppDir)UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppDir)UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Il2CppDir)UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Il2CppDir)UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Il2CppDir)UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Il2CppDir)UnityEngine.ParticleSystemModule.dll</HintPath></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(Il2CppDir)Unity.RenderPipelines.Core.Runtime.dll</HintPath></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(Il2CppDir)Unity.RenderPipelines.Universal.Runtime.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppDir)UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppDir)UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="Il2CppFusion.Runtime"><HintPath>$(Il2CppDir)Il2CppFusion.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppFusion.Common"><HintPath>$(Il2CppDir)Il2CppFusion.Common.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppDir)Unity.TextMeshPro.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The loader reads the plugin from bytes, so this file is never locked: copying while the
       game runs is exactly the point. The loader notices the change and reloads. -->
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(GameDir)UserData\ShiftAtMidnightSuite" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)UserData\ShiftAtMidnightSuite" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(GameDir)UserData\ShiftAtMidnightSuite" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="Plugin deployed to UserData\ShiftAtMidnightSuite - the game will hot-reload it." />
  </Target>

</Project>
